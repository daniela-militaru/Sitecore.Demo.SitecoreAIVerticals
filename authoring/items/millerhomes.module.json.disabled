{
    "$schema": "../.sitecore/schemas/ModuleFile.schema.json",
    "namespace": "Project",
    "items": {
      "path": "Lenovo",
      "includes": [
        {
            "name": "templatesProject",
            "path": "/sitecore/templates/Project/lenovo",
            "allowedPushOperations": "CreateUpdateAndDelete",
            "scope": "ItemAndDescendants"
        },
        {
            "name": "branchesProject",
            "path": "/sitecore/templates/Branches/Project/lenovo",
            "allowedPushOperations": "CreateUpdateAndDelete",
            "scope": "ItemAndDescendants"
        },
        {
          "name": "projectMediaFolders",
          "path": "/sitecore/Media Library/Project/lenovo",
          "scope": "ItemAndDescendants"
        },
        {
          "name": "projectRenderings",
          "path": "/sitecore/Layout/Renderings/Project/lenovo",
          "allowedPushOperations": "CreateUpdateAndDelete",
          "scope": "ItemAndDescendants"
        },
        {
          "name": "projectPlaceholderSettings",
          "path": "/sitecore/Layout/Placeholder Settings/Project/lenovo",
          "allowedPushOperations": "CreateUpdateAndDelete",
          "scope": "ItemAndDescendants"
        },
        {
          "name": "tenantRoot",
          "path": "/sitecore/content/lenovo",
          "scope": "SingleItem",
          "allowedPushOperations": "CreateAndUpdate"
        },
        {
          "name": "site",
          "path": "/sitecore/content/lenovo/lenovo-partner-hub",
          "rules": [
            {
              "path": "/home",
              "scope": "ItemAndDescendants",
              "allowedPushOperations": "CreateAndUpdate"
            },
            {
              "path": "/Media",
              "scope": "ItemAndDescendants",
              "allowedPushOperations": "CreateAndUpdate"
            },
            {
              "path": "/Data",
              "scope": "ItemAndDescendants",
              "allowedPushOperations": "CreateAndUpdate"
            },
            {
              "path": "/Dictionary",
              "scope": "ItemAndDescendants",
              "allowedPushOperations": "CreateAndUpdate"
            },
            {
              "path": "/Presentation",
              "scope": "ItemAndDescendants",
              "allowedPushOperations": "CreateAndUpdate"
            },
            {
              "path": "/Settings/Site Grouping",
              "scope": "ItemAndDescendants",
              "allowedPushOperations": "CreateAndUpdate"
            },
            {
              "path": "/Settings",
              "scope": "ItemAndDescendants",
              "allowedPushOperations": "CreateAndUpdate"
            },
            {
              "path": "*", 
              "scope": "Ignored"
            }
          ]
        }
      ]
    }
  }